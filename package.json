{
  "name": "dev-community-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "tokens": "npm run tokens -w @dev-community/ui",
    "build": "npm run build -w @dev-community/ui && npm run build -w @dev-community/docs",
    "build:lib": "npm run build -w @dev-community/ui",
    "build:docs": "npm run build -w @dev-community/docs",
    "build:storybook": "npm run build-storybook -w @dev-community/ui",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "dev": "npm run dev -w @dev-community/docs",
    "storybook": "npm run storybook -w @dev-community/ui",
    "lint": "eslint . && npm run lint:css -w @dev-community/ui && npm run lint:tokens -w @dev-community/ui",
    "typecheck": "npm run typecheck -w @dev-community/ui && npm run typecheck -w @dev-community/docs",
    "test": "npm run test -w @dev-community/ui",
    "test:e2e": "playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "lint:package": "npm run lint:package -w @dev-community/ui",
    "release:pack": "node scripts/release-pack.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:package && npm run verify:package && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
