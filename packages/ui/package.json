{
  "name": "@dev-community/ui",
  "version": "0.1.0",
  "description": "Design system React/TypeScript: token, temi, componenti accessibili e pattern per portali.",
  "license": "MIT",
  "keywords": [
    "react",
    "design-system",
    "components",
    "accessibility",
    "react-aria",
    "theming",
    "design-tokens",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.dtcg.json",
    "./theme": {
      "types": "./dist/theme/server.d.ts",
      "import": "./dist/theme/server.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./patterns": {
      "types": "./dist/patterns-entry.d.ts",
      "import": "./dist/patterns.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:tokens": "node scripts/check-token-refs.mjs",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./reset.css ./tokens.css",
    "prepublishOnly": "node scripts/prepublish-check.mjs && npm run build && npm run lint:package",
    "stories": "node scripts/generate-stories.mjs",
    "storybook": "npm run stories && storybook dev -p 6006",
    "build-storybook": "npm run stories && storybook build -o storybook-static",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@material/material-color-utilities": "0.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-floating-menu": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "lucide-react": "^1.61.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
